<?xml version="1.0" encoding="UTF-8"?>
<!--
  Este arquivo NÃO faz parte da aplicação Node.js.
  Ele existe só para o Maven baixar o HtmlUnit e o JUnit e executar os testes da pasta "test".
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>projeto.exemplo</groupId>
    <artifactId>testes-htmlunit</artifactId>
    <version>1.0.0</version>

    <properties>
        <!-- HtmlUnit 5.x exige Java 17 ou superior -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <htmlunit.version>5.7.0</htmlunit.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- HtmlUnit: o "navegador sem tela" usado nos testes -->
        <dependency>
            <groupId>org.htmlunit</groupId>
            <artifactId>htmlunit</artifactId>
            <version>${htmlunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5: organiza e executa os testes (@Test, assertEquals...) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Os testes ficam na pasta "test" (e não em src/test/java, que é o padrão do Maven) -->
        <testSourceDirectory>test</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Só executa as classes cujo nome começa com "Teste" -->
                    <includes>
                        <include>**/Teste*.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
